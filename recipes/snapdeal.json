{
  "site": "snapdeal",
  "baseUrl": "https://www.snapdeal.com",
  "steps": [
    {
      "do": "goto",
      "path": "/"
    },
    {
      "do": "click",
      "target": {
        "text": "AKLINA Gold Religious Pendant With Chain ( Pack of 1 )"
      },
      "why": "open a product"
    },
    {
      "do": "wait",
      "ms": 2500,
      "why": "let any countdown tick"
    },
    {
      "do": "reload",
      "why": "check whether urgency timers restart"
    },
    {
      "do": "click",
      "target": {
        "text": "Gold",
        "exact": true
      },
      "why": "choose size/variant \"Gold\" first"
    },
    {
      "do": "click",
      "target": {
        "text": "ADD TO CART",
        "exact": true
      },
      "why": "add the product to the cart",
      "adds": "AKLINA Gold Religious Pendant With Chain ( Pack of 1 )"
    },
    {
      "do": "click",
      "target": {
        "role": "link",
        "name": "PROCEED TO CHECKOUT"
      },
      "why": "proceed to checkout"
    }
  ]
}
